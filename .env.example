# ==============================================================================
# MedBento AI 环境变量配置清单
# ==============================================================================

# 1. 私有化访问鉴权配置 (防范 VPS 公网未授权访问)
# 管理员登录账号 (默认: admin)
AUTH_USERNAME=admin
# 管理员访问密码 (请设置为您自己的强密码，留空则为本地免密开发模式)
AUTH_PASSWORD=123456

# 2. Google Gemini 大模型配置 (用于后端大模型深度医学抽取，留空则自动使用内置离线引擎)
# 获取地址: https://aistudio.google.com/
GEMINI_API_KEY=
# Gemini 模型名称 (默认推荐: gemini-2.5-flash，可选 gemini-1.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. 运行服务与网络配置
# 服务监听端口 (非常用高位端口，避免与 VPS 常用服务冲突)
PORT=38999
# 服务监听地址 (0.0.0.0 支持局域网与 Docker 容器外部穿透)
HOST=0.0.0.0
